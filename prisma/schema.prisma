generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Profile {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique
  name      String
  imageUrl  String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bio       String?
  joinDate  DateTime?
  location  String?
  relationshipStatus RelationshipStatus?
  isOnline  Boolean  @default(false)

  // NEWSFEED
  posts     Post[]
  likes     Like[]


  friendOne Friend[] @relation("FriendOne")
  friendTwo Friend[] @relation("FriendTwo")

  comments  Comment[]

  // Chat
  server   Server[]
  channels Channel[]
  members  Member[]

  conversationsInitiated Conversation[] @relation("ProfileOne")
  conversationsReceived  Conversation[] @relation("ProfileTwo")
  directMessages         DirectMessage[]
  conversationReads      ConversationRead[]

  // Friend requests
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
}

//////////////////////////////////////////////////
// Chat
//////////////////////////////////////////////////

model Server {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  imageUrl   String
  inviteCode String   @unique
  profileId  String
  visibility ServerVisibility @default(PRIVATE)
  memberCount Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // optional pointer to the server's general channel for fast lookup
  generalChannelId String? @unique
  generalChannel   Channel? @relation("ServerGeneralChannel", fields: [generalChannelId], references: [id])

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  members  Member[]
  channels Channel[]

  @@index([profileId])
}

model Member {
  id        String     @id @default(uuid()) @map("_id")
  role      MemberRole @default(GUEST)
  profileId String
  serverId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  server  Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  messages     Message[]
  channelReads ChannelRead[] @relation("MemberChannelReads")
  lectures     Lecture[]
  createdAssessments Assessment[] @relation("CreatedAssessments")
  attempts AssessmentAttempt[] @relation("StudentAttempts")
  gradedAttempts AssessmentAttempt[] @relation("GradedAttempts")

  @@unique([serverId, profileId])
  @@index([profileId])
  @@index([serverId])
}

model Channel {
  id        String      @id @default(uuid()) @map("_id")
  name      String
  type      ChannelType @default(TEXT)
  profileId String
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile  Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  server   Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // back relation for server.generalChannel
  generalForServer Server? @relation("ServerGeneralChannel")
  messages Message[]
  reads    ChannelRead[] @relation("ChannelReads")
  lectures Lecture[]
  assessments Assessment[]

  @@index([profileId])
  @@index([serverId])
}

model Message {
  id        String   @id @default(uuid()) @map("_id")
  content   String
  fileUrl   String?
  fileType  FileType @default(text)
  memberId  String?
  channelId String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isFlagged Boolean @default(false)
  flagReason String?

  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
  @@index([channelId, createdAt])
}

model Conversation {
  id           String @id @default(uuid()) @map("_id")
  profileOneId String
  profileTwoId String

  profileOne Profile @relation("ProfileOne", fields: [profileOneId], references: [id], onDelete: Cascade)
  profileTwo Profile @relation("ProfileTwo", fields: [profileTwoId], references: [id], onDelete: Cascade)

  directMessages DirectMessage[]
  reads          ConversationRead[]

  @@unique([profileOneId, profileTwoId])
  @@index([profileOneId])
  @@index([profileTwoId])
}

model DirectMessage {
  id             String   @id @default(uuid()) @map("_id")
  content        String
  fileUrl        String?
  fileType       FileType @default(text)
  senderId       String
  conversationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deleted        Boolean  @default(false)

  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model ConversationRead {
  id String @id @default(uuid()) @map("_id")

  profileId      String
  conversationId String

  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  @@unique([profileId, conversationId])
  @@index([conversationId])
  @@index([conversationId, lastReadAt])
}

model ChannelRead {
  id String @id @default(uuid()) @map("_id")

  memberId String
  member   Member @relation("MemberChannelReads", fields: [memberId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation("ChannelReads", fields: [channelId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())
  formerLastReadAt DateTime?
  isNotify Boolean @default(true)

  @@unique([memberId, channelId])
  @@index([channelId])
  @@index([channelId, lastReadAt])
}

//////////////////////////////////////////////////
// NEWSFEED
//////////////////////////////////////////////////

model Post {
  id        String   @id @default(uuid()) @map("_id")
  content   String
  fileUrl   String?
  fileType  FileType @default(text)

  authorId  String
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  visibility PostVisibility @default(PUBLIC)

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  likes    Like[]
  comments Comment[]

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid()) @map("_id")
  content   String

  authorId  String
  author    Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id     String @id @default(uuid())
  userId String
  postId String

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}


model Friend {
  id        String @id @default(uuid())

  userOneId String
  userTwoId String

  userOne Profile @relation("FriendOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo Profile @relation("FriendTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  pairKey    String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   Profile @relation("SentRequests",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver Profile @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([pairKey])
  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([senderId, status])
  @@index([receiverId])
  @@index([receiverId, status])
}

// ENUM
enum MemberRole {
  SERVEROWNER
  VICESERVEROWNER
  GUEST
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

enum FileType {
  text
  img
  pdf
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RelationshipStatus {
  SINGLE
  MARRIED
  DATING
}

enum ServerVisibility {
  PUBLIC
  PRIVATE
}

//////////////////////////////////////////////////
// LECTURE & LEARNING
//////////////////////////////////////////////////

model Lecture {
  id String @id @default(uuid()) @map("_id")

  title String
  fileUrl String
  fileType LectureFileType

  extractedContent String?

  channelId String
  memberId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  summary Summary?
  flashcardSet FlashcardSet?
  assessment Assessment?

  @@index([channelId, createdAt])
  @@index([memberId])
}

model Summary {
  id String @id @default(uuid()) @map("_id")

  lectureId String

  tone SummaryTone @default(CONCISE)

  contentMarkdown String

  createdAt DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@unique([lectureId])
}

model Flashcard {
  id String @id @default(uuid()) @map("_id")

  flashcardSetId String

  order Int

  frontText String
  backText String

  createdAt DateTime @default(now())

  flashcardSet FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId])
}

model FlashcardSet {
  id String @id @default(uuid()) @map("_id")
  lectureId String @unique

  createdAt DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  flashcards Flashcard[]

  @@index([lectureId])
}

model Assessment {
  id String @id @default(uuid()) @map("_id")

  lectureId String?
  channelId String

  createdById String

  title String
  description String?

  type AssessmentType

  generatedByAI Boolean @default(false)

  status AssessmentStatus @default(DRAFT)

  totalQuestions Int
  totalPoints Float @default(0)

  durationMinutes Int?

  allowLateSubmission Boolean @default(false)

  expiresAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecture Lecture? @relation(fields: [lectureId], references: [id], onDelete: SetNull)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdBy Member @relation("CreatedAssessments", fields: [createdById], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]
  attempts AssessmentAttempt[]

  @@index([lectureId])
  @@unique([lectureId])
  @@index([channelId])
  @@index([createdById])
  @@index([channelId, status, expiresAt])
}

model AssessmentQuestion {
  id String @id @default(uuid()) @map("_id")

  assessmentId String

  order Int

  questionText String

  type QuestionType @default(MULTIPLE_CHOICE)

  points Float @default(1)

  explanation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  options AssessmentOption[]
  answers AssessmentAnswer[]

  @@index([assessmentId])
  @@unique([assessmentId, order])
}

model AssessmentOption {
  id String @id @default(uuid()) @map("_id")

  questionId String

  order Int

  optionText String

  isCorrect Boolean @default(false)

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AssessmentAttempt {
  id String @id @default(uuid()) @map("_id")

  assessmentId String
  memberId String

  startedAt DateTime @default(now())
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  isLate Boolean @default(false)

  autoScore Float @default(0)

  scorePercent Float @default(0)

  teacherAdjustment Float @default(0)

  finalScore Float @default(0)

  teacherComment String?

  gradedAt DateTime?

  gradedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  member Member @relation("StudentAttempts", fields: [memberId], references: [id], onDelete: Cascade)
  gradedBy Member? @relation("GradedAttempts", fields: [gradedById], references: [id], onDelete: SetNull)

  answers AssessmentAnswer[]

  @@index([assessmentId])
  @@index([memberId])
  @@unique([assessmentId, memberId])
  @@index([assessmentId, finalScore])
}

model AssessmentAnswer {
  id String @id @default(uuid()) @map("_id")

  attemptId String
  questionId String

  selectedOptionId String?

  answerText String?

  isCorrect Boolean?

  autoPoints Float?
  teacherAdjustedPoints Float?

  finalPoints Float?

  teacherFeedback String?

  gradedAt DateTime?

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  questionSnapshot Json?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

enum LectureFileType {
  PDF
  DOCX
  TXT
  IMAGE
}

enum SummaryTone {
  CONCISE
  DETAILED
  SIMPLE
  ACADEMIC
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  RETURNED
  EXPIRED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  ESSAY
}